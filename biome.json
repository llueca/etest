{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!infra",
      "!openspec",
      "!.opencode",
      "!.idea",
      "!playwright-report",
      "!test-results",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["tests/contract/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateTestHooks": "off"
          }
        }
      }
    }
  ]
}
